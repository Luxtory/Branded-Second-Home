{
  "$description": "Luxtory Design System tokens — single source of truth (W3C DTCG). Edit here, then run: node src/design-system/scripts/build-tokens.mjs. Spec: docs/specs/design-system.md",
  "palette": {
    "$description": "Immutable brand palette. Never add brand colors.",
    "moroccan-blue": { "$type": "color", "$value": "#0F4E67" },
    "dark-moroccan-blue": { "$type": "color", "$value": "#003D52" },
    "warm-sand": { "$type": "color", "$value": "#CDAD8E" },
    "dark-warm-sand": { "$type": "color", "$value": "#9E8567" },
    "pure-white": { "$type": "color", "$value": "#FFFFFF" }
  },
  "derived": {
    "$description": "Functional colors derived for accessibility and states. Not brand colors.",
    "sand-wash": { "$type": "color", "$value": "#F7F2ED", "$description": "Warm Sand 16% over Pure White" },
    "error": { "$type": "color", "$value": "#9B2226", "$description": "Error on paper/wash" },
    "error-on-night": { "$type": "color", "$value": "#F2B8B5", "$description": "Error on night" }
  },
  "ground": {
    "$description": "Semantic colors per ground. Emitted as --lx-color-<name> and re-scoped by [data-ground].",
    "paper": {
      "bg": { "$type": "color", "$value": "{palette.pure-white}" },
      "surface": { "$type": "color", "$value": "{derived.sand-wash}" },
      "fg": { "$type": "color", "$value": "{palette.dark-moroccan-blue}" },
      "fg-muted": { "$type": "color", "$value": "{palette.moroccan-blue}" },
      "accent": { "$type": "color", "$value": "{palette.moroccan-blue}" },
      "marker": { "$type": "color", "$value": "{palette.moroccan-blue}" },
      "rule": { "$type": "color", "$value": "{palette.warm-sand}" },
      "rule-strong": { "$type": "color", "$value": "{palette.moroccan-blue}" },
      "focus": { "$type": "color", "$value": "{palette.moroccan-blue}" },
      "action-bg": { "$type": "color", "$value": "{palette.dark-moroccan-blue}" },
      "action-bg-hover": { "$type": "color", "$value": "{palette.moroccan-blue}" },
      "action-fg": { "$type": "color", "$value": "{palette.pure-white}" },
      "field-bg": { "$type": "color", "$value": "{palette.pure-white}" },
      "field-fg": { "$type": "color", "$value": "{palette.dark-moroccan-blue}" },
      "field-border": { "$type": "color", "$value": "{palette.moroccan-blue}" },
      "error": { "$type": "color", "$value": "{derived.error}" },
      "success": { "$type": "color", "$value": "{palette.moroccan-blue}" },
      "warning": { "$type": "color", "$value": "{palette.dark-warm-sand}" },
      "skeleton": { "$type": "color", "$value": "{derived.sand-wash}" },
      "selection-bg": { "$type": "color", "$value": "{palette.warm-sand}" },
      "selection-fg": { "$type": "color", "$value": "{palette.dark-moroccan-blue}" }
    },
    "wash": {
      "bg": { "$type": "color", "$value": "{derived.sand-wash}" },
      "surface": { "$type": "color", "$value": "{palette.pure-white}" },
      "fg": { "$type": "color", "$value": "{palette.dark-moroccan-blue}" },
      "fg-muted": { "$type": "color", "$value": "{palette.moroccan-blue}" },
      "accent": { "$type": "color", "$value": "{palette.moroccan-blue}" },
      "marker": { "$type": "color", "$value": "{palette.moroccan-blue}" },
      "rule": { "$type": "color", "$value": "{palette.warm-sand}" },
      "rule-strong": { "$type": "color", "$value": "{palette.moroccan-blue}" },
      "focus": { "$type": "color", "$value": "{palette.moroccan-blue}" },
      "action-bg": { "$type": "color", "$value": "{palette.dark-moroccan-blue}" },
      "action-bg-hover": { "$type": "color", "$value": "{palette.moroccan-blue}" },
      "action-fg": { "$type": "color", "$value": "{palette.pure-white}" },
      "field-bg": { "$type": "color", "$value": "{palette.pure-white}" },
      "field-fg": { "$type": "color", "$value": "{palette.dark-moroccan-blue}" },
      "field-border": { "$type": "color", "$value": "{palette.moroccan-blue}" },
      "error": { "$type": "color", "$value": "{derived.error}" },
      "success": { "$type": "color", "$value": "{palette.moroccan-blue}" },
      "warning": { "$type": "color", "$value": "{palette.dark-warm-sand}" },
      "skeleton": { "$type": "color", "$value": "{palette.pure-white}" },
      "selection-bg": { "$type": "color", "$value": "{palette.warm-sand}" },
      "selection-fg": { "$type": "color", "$value": "{palette.dark-moroccan-blue}" }
    },
    "night": {
      "bg": { "$type": "color", "$value": "{palette.dark-moroccan-blue}" },
      "surface": { "$type": "color", "$value": "{palette.dark-moroccan-blue}", "$description": "On night, surfaces separate by hairline, not by fill" },
      "fg": { "$type": "color", "$value": "{palette.pure-white}" },
      "fg-muted": { "$type": "color", "$value": "{palette.warm-sand}" },
      "accent": { "$type": "color", "$value": "{palette.warm-sand}" },
      "marker": { "$type": "color", "$value": "{palette.warm-sand}" },
      "rule": { "$type": "color", "$value": "{palette.warm-sand}" },
      "rule-strong": { "$type": "color", "$value": "{palette.warm-sand}" },
      "focus": { "$type": "color", "$value": "{palette.warm-sand}" },
      "action-bg": { "$type": "color", "$value": "{palette.warm-sand}" },
      "action-bg-hover": { "$type": "color", "$value": "{palette.pure-white}" },
      "action-fg": { "$type": "color", "$value": "{palette.dark-moroccan-blue}" },
      "field-bg": { "$type": "color", "$value": "{palette.dark-moroccan-blue}" },
      "field-fg": { "$type": "color", "$value": "{palette.pure-white}" },
      "field-border": { "$type": "color", "$value": "{palette.warm-sand}" },
      "error": { "$type": "color", "$value": "{derived.error-on-night}" },
      "success": { "$type": "color", "$value": "{palette.pure-white}" },
      "warning": { "$type": "color", "$value": "{palette.warm-sand}" },
      "skeleton": { "$type": "color", "$value": "{palette.moroccan-blue}" },
      "selection-bg": { "$type": "color", "$value": "{palette.warm-sand}" },
      "selection-fg": { "$type": "color", "$value": "{palette.dark-moroccan-blue}" }
    }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": "\"Newsreader\", \"Newsreader Fallback\", \"Times New Roman\", serif", "$description": "LUXURY voice" },
    "utility": { "$type": "fontFamily", "$value": "\"Hanken Grotesk\", \"Hanken Grotesk Fallback\", Arial, sans-serif", "$description": "UTILITY voice" },
    "story": { "$type": "fontFamily", "$value": "\"Courier Prime\", \"Courier New\", monospace", "$description": "STORY voice — markers and captions only" }
  },
  "weight": {
    "display": { "$type": "fontWeight", "$value": 400 },
    "display-strong": { "$type": "fontWeight", "$value": 500 },
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium": { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 },
    "story": { "$type": "fontWeight", "$value": 400 },
    "story-strong": { "$type": "fontWeight", "$value": 700 }
  },
  "text": {
    "$description": "Fluid type scale (rem, clamp). Body 17→18px.",
    "display-xl": { "$type": "dimension", "$value": "clamp(2.75rem, 1.6rem + 4.6vw, 6rem)" },
    "display-l": { "$type": "dimension", "$value": "clamp(2.25rem, 1.5rem + 3vw, 4.25rem)" },
    "display-m": { "$type": "dimension", "$value": "clamp(1.75rem, 1.35rem + 1.6vw, 2.75rem)" },
    "display-s": { "$type": "dimension", "$value": "clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem)" },
    "lead": { "$type": "dimension", "$value": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.375rem)" },
    "body": { "$type": "dimension", "$value": "clamp(1.0625rem, 1.03rem + 0.15vw, 1.125rem)" },
    "small": { "$type": "dimension", "$value": "0.9375rem" },
    "label": { "$type": "dimension", "$value": "1rem" },
    "marker": { "$type": "dimension", "$value": "0.8125rem" }
  },
  "leading": {
    "display": { "$type": "number", "$value": 1.06 },
    "heading": { "$type": "number", "$value": 1.15 },
    "body": { "$type": "number", "$value": 1.6 },
    "tight": { "$type": "number", "$value": 1.3 },
    "marker": { "$type": "number", "$value": 1.5 }
  },
  "tracking": {
    "display": { "$type": "dimension", "$value": "-0.015em" },
    "body": { "$type": "dimension", "$value": "0em" },
    "label": { "$type": "dimension", "$value": "0.01em" },
    "marker": { "$type": "dimension", "$value": "0.14em" }
  },
  "measure": {
    "body": { "$type": "dimension", "$value": "66ch" },
    "narrow": { "$type": "dimension", "$value": "40ch" },
    "display": { "$type": "dimension", "$value": "18ch" }
  },
  "space": {
    "$description": "4px base.",
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "24": { "$type": "dimension", "$value": "6rem" },
    "32": { "$type": "dimension", "$value": "8rem" },
    "48": { "$type": "dimension", "$value": "12rem" },
    "scene": { "$type": "dimension", "$value": "clamp(4rem, 2.5rem + 7vw, 10rem)", "$description": "Vertical rhythm between Scenes" },
    "stack": { "$type": "dimension", "$value": "clamp(1.5rem, 1.2rem + 1.2vw, 2.5rem)" }
  },
  "layout": {
    "container-max": { "$type": "dimension", "$value": "90rem" },
    "container-narrow": { "$type": "dimension", "$value": "56rem" },
    "margin": { "$type": "dimension", "$value": "clamp(1.25rem, 0.5rem + 4vw, 6rem)" },
    "gutter": { "$type": "dimension", "$value": "clamp(1rem, 0.6rem + 1.4vw, 2rem)" },
    "columns-sm": { "$type": "number", "$value": 4 },
    "columns-md": { "$type": "number", "$value": 8 },
    "columns-lg": { "$type": "number", "$value": 12 },
    "header-height": { "$type": "dimension", "$value": "4.5rem" },
    "app-nav-width": { "$type": "dimension", "$value": "17.5rem", "$description": "App Shell side navigation from lg (ADR-0009)" },
    "focused-width": { "$type": "dimension", "$value": "32rem", "$description": "Focused layout panel from md (ADR-0009)" }
  },
  "breakpoint": {
    "$description": "Use only these values in @media (min-width: …). 4 cols < md ≤ 8 cols < lg ≤ 12 cols.",
    "sm": { "$type": "dimension", "$value": "30rem" },
    "md": { "$type": "dimension", "$value": "48rem" },
    "lg": { "$type": "dimension", "$value": "64rem" },
    "xl": { "$type": "dimension", "$value": "80rem" },
    "2xl": { "$type": "dimension", "$value": "100rem" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0" },
    "hairline": { "$type": "dimension", "$value": "2px", "$description": "Checkbox and focus ring only" }
  },
  "border": {
    "hairline": { "$type": "dimension", "$value": "1px" },
    "strong": { "$type": "dimension", "$value": "1px" },
    "marker-tick": { "$type": "dimension", "$value": "0.5625rem" }
  },
  "focus": {
    "width": { "$type": "dimension", "$value": "2px" },
    "offset": { "$type": "dimension", "$value": "3px" }
  },
  "shadow": {
    "overlay": { "$type": "shadow", "$value": "0 1.5rem 3rem -1.5rem color-mix(in srgb, var(--lx-palette-dark-moroccan-blue) 35%, transparent)", "$description": "The only shadow: overlays (dialog, menus)" }
  },
  "z": {
    "base": { "$type": "number", "$value": 0 },
    "raised": { "$type": "number", "$value": 10 },
    "sticky": { "$type": "number", "$value": 100 },
    "overlay": { "$type": "number", "$value": 200 },
    "modal": { "$type": "number", "$value": 300 },
    "toast": { "$type": "number", "$value": 400 },
    "skip-link": { "$type": "number", "$value": 500 }
  },
  "duration": {
    "instant": { "$type": "duration", "$value": "80ms" },
    "quick": { "$type": "duration", "$value": "160ms" },
    "base": { "$type": "duration", "$value": "240ms" },
    "slow": { "$type": "duration", "$value": "480ms" },
    "cinematic": { "$type": "duration", "$value": "900ms" },
    "drift": { "$type": "duration", "$value": "4800ms", "$description": "Opening Frame settle; ≤ 5s and runs once (WCAG 2.2.2)" },
    "reduced": { "$type": "duration", "$value": "150ms", "$description": "Max fade under reduced motion" }
  },
  "ease": {
    "settle": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)" },
    "cinematic": { "$type": "cubicBezier", "$value": "cubic-bezier(0.65, 0, 0.35, 1)" },
    "exit": { "$type": "cubicBezier", "$value": "cubic-bezier(0.4, 0, 1, 1)" }
  },
  "target": {
    "min": { "$type": "dimension", "$value": "2.75rem", "$description": "44px minimum touch target" },
    "control": { "$type": "dimension", "$value": "3rem", "$description": "48px form controls and buttons" }
  },
  "ratio": {
    "establishing": { "$type": "number", "$value": "21 / 9" },
    "establishing-mobile": { "$type": "number", "$value": "4 / 5" },
    "living": { "$type": "number", "$value": "3 / 2" },
    "detail": { "$type": "number", "$value": "4 / 5" }
  },
  "scrim": {
    "color": { "$type": "color", "$value": "{palette.dark-moroccan-blue}" },
    "min-alpha": { "$type": "number", "$value": 0.68, "$description": "Minimum scrim opacity under white text (worst case: white pixel) → ≥ 4.5:1" },
    "max-alpha": { "$type": "number", "$value": 0.84 }
  },
  "grain": {
    "image": { "$type": "other", "$value": "url(\"data:image/svg+xml,%3Csvg viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23g)'/%3E%3C/svg%3E\")" },
    "size": { "$type": "dimension", "$value": "120px" },
    "opacity": { "$type": "number", "$value": 0.035 }
  },
  "$extensions": {
    "lx.contrast": {
      "$description": "Pairs enforced by scripts/check-contrast.mjs for every ground. text = 4.5:1, ui = 3:1 (WCAG 2.2 AA).",
      "text": [
        ["fg", "bg"], ["fg-muted", "bg"], ["accent", "bg"], ["marker", "bg"], ["error", "bg"], ["success", "bg"],
        ["fg", "surface"], ["fg-muted", "surface"], ["accent", "surface"],
        ["action-fg", "action-bg"], ["action-fg", "action-bg-hover"], ["field-fg", "field-bg"], ["error", "field-bg"],
        ["selection-fg", "selection-bg"]
      ],
      "ui": [
        ["rule-strong", "bg"], ["focus", "bg"], ["field-border", "bg"], ["field-border", "field-bg"], ["warning", "bg"],
        ["focus", "surface"], ["rule-strong", "surface"]
      ]
    }
  }
}
