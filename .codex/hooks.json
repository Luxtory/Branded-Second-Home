          {
            "type": "command",
            "command": "'/mnt/c/Users/rjr-idb/Documents/branded_second_home_luxtory/.codex/hooks/pre-compact-snapshot.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "'/mnt/c/Users/rjr-idb/Documents/branded_second_home_luxtory/.codex/hooks/session-start-context.sh'"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "'/mnt/c/Users/rjr-idb/Documents/branded_second_home_luxtory/.codex/hooks/session-start-compact-resume.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
