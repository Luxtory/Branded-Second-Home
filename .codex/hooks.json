{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "'/mnt/c/Users/rjr-idb/Documents/branded_second_home_luxtory/.codex/hooks/block-secrets.sh'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "'/mnt/c/Users/rjr-idb/Documents/branded_second_home_luxtory/.codex/hooks/format-on-save.sh'"
          },
          {
            "type": "command",
